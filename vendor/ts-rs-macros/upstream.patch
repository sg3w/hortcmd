+#[cfg(test)]
+mod compatibility_tests {
+    use super::*;
+
+    #[test]
+    fn only_the_supported_omission_predicate_is_accepted() {
+        let known: Attribute = syn::parse_quote!(#[serde(skip_serializing_if = "Option::is_none")]);
+        let parsed = Serde::<FieldAttr>::try_from(&known).unwrap();
+        assert!(parsed.0.optional.optional);
+        assert!(!parsed.0.optional.nullable);
+        let unknown: Attribute =
+            syn::parse_quote!(#[serde(skip_serializing_if = "custom_predicate")]);
+        assert!(Serde::<FieldAttr>::try_from(&unknown).is_err());
+        let unknown: Attribute = syn::parse_quote!(#[serde(unrecognized_attribute)]);
+        assert!(Serde::<FieldAttr>::try_from(&unknown).is_err());
+    }

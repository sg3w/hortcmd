{
  "name": "hortcmd",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Dateicommander im Total-Commander-Stil mit Rust + Tauri",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:harness": "node harness/harness.mjs run",
    "gen:types": "cargo test --manifest-path src-tauri/Cargo.toml export_bindings",
    "check:bindings": "node scripts/check-bindings.mjs",
    "check:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "check:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --locked --all-targets --all-features -- -D warnings",
    "check:rust": "cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "check": "npm run check:fmt && npm run check:clippy && npm run check:rust && npm run check:bindings && npm run check:errorcodes && npm run check:boundaries && npm run check:docs && npm run check:ui-text && npm run typecheck && npm test && npm run build && npm run check:bundle",
    "tauri": "tauri",
    "check:bundle": "node scripts/bundle-report.mjs",
    "bundle:report": "node scripts/bundle-report.mjs --build",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "gen:errorcodes": "node scripts/gen-error-codes.mjs",
    "check:errorcodes": "node scripts/gen-error-codes.mjs --check",
    "check:docs": "node scripts/check-docs.mjs",
    "check:ui-text": "node --test scripts/check-ui-text.test.mjs && node scripts/check-ui-text.mjs"
  },
  "dependencies": {
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-menubar": "^1.1.24",
    "@radix-ui/react-select": "^2.3.3",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.5",
    "@tauri-apps/api": "^2.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.15",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.23.0",
    "marked": "^18.0.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "~6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.2",
    "axe-core": "^4.13.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  }
}
